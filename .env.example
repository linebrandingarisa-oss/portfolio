# コピーして `.env.local` として保存し、値を書き換えてください（.env.local は Git に含めない）
#
# 本番: Resend のドメイン検証とホスティングの環境変数は docs/resend-production-setup.md を参照。

# ヘッダー・フッター等に出るサイト名（任意。未設定時は content/site.ts のデフォルト）
NEXT_PUBLIC_SITE_BRAND_NAME=

# 特定商取引法ページ（/tokushoho）の表示用。未設定時は販売事業者「AI集客ラボ Kanagawa」、責任者「あなたの氏名」
NEXT_PUBLIC_TOKUSHOHO_SELLER_NAME=
NEXT_PUBLIC_TOKUSHOHO_REPRESENTATIVE=

# お問い合わせの受信先（サイト表示とメール送信の両方に使います）
NEXT_PUBLIC_CONTACT_EMAIL=

# お問い合わせ API のレート制限（本番推奨: https://upstash.com で Redis を作成し REST URL/トークンを設定）
# 未設定時はサーバー内メモリのみの簡易制限（サーバーレスではインスタンスごとに別枠になる点に注意）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend（https://resend.com）— サーバーからメール送信する場合に必須（NEXT_PUBLIC_ は付けない）
RESEND_API_KEY=
# 開発例: onboarding@resend.dev または 表示名 <onboarding@resend.dev>
# 本番例: 表示名 <form@あなたのドメイン>（Resend でドメイン検証済みのアドレス）
RESEND_FROM=

# X（旧 Twitter）プロフィール URL
NEXT_PUBLIC_X_URL=

# Instagram（未設定時は @tekuteku.consulting / content/site.ts のデフォルト URL）
# 別アカウントに差し替える場合のみ設定。クエリ（?__pwa=1 等）は付けない URL を推奨。
NEXT_PUBLIC_INSTAGRAM_URL=

# note プロフィール（未設定時は content/site.ts のデフォルト URL を使用）
NEXT_PUBLIC_NOTE_URL=

# プロフィール欄の表示名（任意。未設定時は content/site.ts の「Arisa Nishi」）
NEXT_PUBLIC_PROFILE_NAME=

# プロフィール写真を同じパスで差し替えたあと表示が古いとき、日付など好きな文字列に更新して再ビルド（キャッシュバスタ）
NEXT_PUBLIC_PROFILE_PHOTO_REVISION=
